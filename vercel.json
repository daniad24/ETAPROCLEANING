{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "site",
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/admin/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store" }, { "key": "X-Frame-Options", "value": "DENY" } ] }
  ]
}
